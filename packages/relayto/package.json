{
  "name": "relayto",
  "version": "1.0.0",
  "description": "Official RELAYTO SDK and CLI: search and read the pages, hubs and documents of any site published with RELAYTO through its public API. No API key.",
  "keywords": [
    "relayto",
    "sdk",
    "cli",
    "api-client",
    "interactive-content",
    "published-site",
    "markdown",
    "hubs",
    "ai-agents"
  ],
  "homepage": "https://relayto.com",
  "bugs": {
    "url": "https://github.com/relayto/relayto-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relayto/relayto-mcp.git",
    "directory": "packages/relayto"
  },
  "license": "MIT",
  "author": "RELAYTO (https://relayto.com)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "relayto": "dist/bin.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "npm run typecheck && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
